{
  // Cloudflare Workers static-assets config for the ABX Intelligence site.
  // There is no build step: the contents of public/ are uploaded as-is.
  "name": "abx-intelligence-com",
  "compatibility_date": "2026-09-07",
  "assets": {
    "directory": "./public",
    // Serve public/404.html for any address that does not match a file.
    "not_found_handling": "404-page"
  }
}
