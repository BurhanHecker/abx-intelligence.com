{
  // Cloudflare Workers static-assets config for the ABX Intelligence site.
  // There is no build step: the contents of public/ are uploaded as-is.
  "name": "abx-intelligence-com",
  "compatibility_date": "2026-09-07",
  // A small Worker that adds byte-range support for video (iPhones need it).
  // It runs only for /assets/video/*; every other file is served directly.
  "main": "./worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Serve public/404.html for any address that does not match a file.
    "not_found_handling": "404-page",
    "run_worker_first": ["/assets/video/*"]
  }
}
